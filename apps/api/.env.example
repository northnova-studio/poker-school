# ─────────────────────────────────────────────────────────────────────────────
# API scuola di poker (TRIS) — variabili d'ambiente
# Copia in .env per lo sviluppo locale. In produzione impostale nel pannello del
# provider (Railway/Render): MAI committare valori reali.
# Le variabili segnate [OBBLIGATORIA] devono esistere in produzione, altrimenti
# il server non parte. In sviluppo hanno default sicuri solo per uso locale.
# ─────────────────────────────────────────────────────────────────────────────

# ── Generale ────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=4000
LOG_LEVEL=info                       # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=1                        # numero di proxy davanti all'app (Railway/Render: 1)

# [OBBLIGATORIA] Postgres. Railway: ${{Postgres.DATABASE_URL}}; Neon/Supabase: stringa con ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poker_school

# URL pubblico di QUESTA API (link firmati dei documenti KYC, segnaposto video)
PUBLIC_API_URL=http://localhost:4000
# URL del frontend (redirect dopo Stripe Checkout). GitHub Pages: https://northnova-studio.github.io/<repo>
FRONTEND_URL=http://localhost:5173
# Origini ammesse dal CORS, separate da virgola (solo origine, senza percorso)
CORS_ORIGINS=https://northnova-studio.github.io,http://localhost:5173

# ── Autenticazione ──────────────────────────────────────────────────────────
# [OBBLIGATORIA] almeno 32 caratteri casuali: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m                   # durata access token
REFRESH_TOKEN_TTL_DAYS=30            # durata refresh token (ruotato a ogni uso)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10              # tentativi di login per IP ogni 15 minuti
RATE_LIMIT_REGISTER_MAX=5            # registrazioni per IP ogni ora
LEGAL_TERMS_VERSION=2026-11          # versione dei termini accettati (salvata col consenso)
LEGAL_PRIVACY_VERSION=2026-11

# ── Verifica identità (KYC) ─────────────────────────────────────────────────
# [OBBLIGATORIA] chiave AES-256-GCM, 32 byte in base64: openssl rand -base64 32
# CONSERVALA in un password manager: se la perdi i documenti non sono più leggibili.
KYC_ENC_KEY=
KYC_URL_SIGNING_SECRET=              # facoltativa: se vuota è derivata da KYC_ENC_KEY (HKDF)
KYC_URL_TTL_SECONDS=300              # validità dei link firmati per l'admin (5 minuti)
KYC_RETENTION_DAYS=30                # giorni dopo l'esito prima di cancellare i documenti
KYC_MAX_FILE_MB=8
KYC_PROVIDER=MANUAL                  # MANUAL | VERIFF | SUMSUB | DIDIT (gli ultimi tre sono stub)
KYC_WEBHOOK_SECRET=                  # segreto HMAC dei webhook del provider esterno

# Storage documenti (sempre cifrati): local (solo sviluppo) | s3 (Cloudflare R2 in produzione)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=                         # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto                       # R2: auto
S3_BUCKET=                           # es. tris-kyc (bucket PRIVATO, nessun accesso pubblico)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Pagamenti (facoltativi) ─────────────────────────────────────────────────
# Senza STRIPE_SECRET_KEY il checkout risponde 503 "Pagamenti non configurati".
STRIPE_SECRET_KEY=                   # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=               # whsec_... dell'endpoint <PUBLIC_API_URL>/api/v1/billing/webhook
STRIPE_PRICE_BASE_MONTH=             # price_... (prezzo ricorrente mensile del piano Base)
STRIPE_PRICE_BASE_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_ELITE_MONTH=
STRIPE_PRICE_ELITE_YEAR=

# Listino piani in euro (scritto nel DB dal seed; deve coincidere con i prezzi Stripe)
PLAN_BASE_MONTHLY=39
PLAN_BASE_YEARLY=390
PLAN_PRO_MONTHLY=89
PLAN_PRO_YEARLY=890
PLAN_ELITE_MONTHLY=249
PLAN_ELITE_YEARLY=2490

# ── Video (facoltativo): Bunny Stream con token authentication ─────────────
BUNNY_STREAM_LIBRARY_ID=             # ID della Video Library
BUNNY_STREAM_TOKEN_KEY=              # Security → Token Authentication Key
BUNNY_STREAM_EMBED_HOST=https://iframe.mediadelivery.net
VIDEO_URL_TTL_SECONDS=7200           # validità del link firmato al video

# ── Job pianificati (retention KYC ogni 6 ore, rollover stagioni ogni ora) ──
JOBS_ENABLED=true                    # con più repliche: true su una sola, oppure cron esterno

# ── Seed (npm run prisma:seed / node dist/prisma/seed.js) ───────────────────
ADMIN_EMAIL=                         # [OBBLIGATORIA per il seed in produzione]
ADMIN_PASSWORD=                      # [OBBLIGATORIA per il seed in produzione] min 12 caratteri
SEED_FOUNDER_PASSWORD=               # [OBBLIGATORIA per il seed in produzione] password iniziale dei fondatori
SEED_EMAIL_DOMAIN=tris.local         # email fondatori: fabri@, matteo@, lorenzo@<dominio>
SEED_DEMO=                           # true = crea studenti/sessioni di prova (default: solo fuori produzione)
